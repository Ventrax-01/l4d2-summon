# Copiar a .env.local y ajustar. Ningún valor de aquí es secreto.

# mock = la app funciona entera sin backend (desarrollo y demo)
# http = contra el backend real
VITE_API_MODE=mock

# Base de la API cuando VITE_API_MODE=http. En producción todo va tras el mismo
# origen (CloudFront), así que basta con la ruta.
VITE_API_BASE=/api

# Se puede forzar el modo mock en cualquier despliegue con ?mock=1 en la URL.
