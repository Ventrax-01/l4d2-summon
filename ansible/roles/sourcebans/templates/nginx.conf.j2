# Managed by Ansible. Do not edit by hand.

# El 80 solo existe para que Let's Encrypt pueda validar el dominio; todo lo demás se manda
# a HTTPS. El panel nunca se sirve sin cifrar: lleva credenciales de administración.
server {
    listen 80;
    server_name {{ sourcebans_hostname }};

    location /.well-known/acme-challenge/ { root /var/www/certbot; }
    location / { return 301 https://$host$request_uri; }
}

server {
    listen 443 ssl;
    http2 on;
    server_name {{ sourcebans_hostname }};

    ssl_certificate     /etc/letsencrypt/live/{{ sourcebans_hostname }}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/{{ sourcebans_hostname }}/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;

    # El panel es una aplicacion de administracion expuesta a internet: conviene que los
    # navegadores no la degraden ni la enmarquen.
    add_header Strict-Transport-Security "max-age=63072000" always;
    add_header X-Frame-Options DENY always;
    add_header X-Content-Type-Options nosniff always;

    location / {
        proxy_pass http://web:80;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
    }
}
