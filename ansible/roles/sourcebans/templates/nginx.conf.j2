# Managed by Ansible. Do not edit by hand.

# El panel se sirve bajo /sourcebans/ y no en la raíz. No es capricho: CloudFront lo publica
# en esa misma ruta, y como el panel usa enlaces relativos (`../themes/...`), sirviéndolo en
# la misma ruta de punta a punta no hay que reescribir nada.
server {
    listen {{ sourcebans_https_port }} ssl;
    http2 on;
    server_name {{ sourcebans_hostname }};

    ssl_certificate     /etc/letsencrypt/live/{{ sourcebans_hostname }}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/{{ sourcebans_hostname }}/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;

    add_header Strict-Transport-Security "max-age=63072000" always;
    add_header X-Content-Type-Options nosniff always;

    location /sourcebans/ {
        # Solo se atiende lo que llega por CloudFront. Quien dé con el puerto y pruebe a
        # mano se encuentra un 403: el panel no queda expuesto por su cuenta. Va DENTRO del
        # location y no a nivel de servidor, o taparía también el /health de abajo.
        if ($http_x_origen_secreto != "{{ sourcebans_origen_secreto }}") { return 403; }

        proxy_pass http://web:80/;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
    }

    location = /health { return 200 "ok\n"; }
    location / { return 404; }
}
